// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  employeeNumber         String?   @unique
  username               String    @unique
  email                  String    @unique
  passwordHash           String
  firstName              String?
  lastName               String?
  displayName            String?
  profilePhoto           String?
  phone                  String?
  department             String?
  status                 String    @default("Active") // Active, Inactive, Locked, Suspended, Pending Activation
  failedLogins           Int       @default(0)
  lockedUntil            DateTime?
  requiresPasswordChange Boolean   @default(true)
  lastLogin              DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  userRoles       UserRole[]
  userPermissions UserPermission[]
  sessions        Session[]
  auditLogs       AuditLog[]

  // Core domain relations
  createdOrders          Order[]         @relation("OrderCreatedBy")
  processedPayments      Payment[]       @relation("PaymentCreatedBy")
  stockMovements         StockMovement[] @relation("StockMovementCreatedBy")
  assignedProductionJobs ProductionJob[] @relation("ProductionJobAssignedTo")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Administrator, Owner, Manager, etc.
  description String?
  isSystem    Boolean  @default(false) // Cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // products.view, orders.create, etc.
  description String?
  module      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  branchId  String? // Optional branch-level role scoping
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  isGranted    Boolean  @default(true) // true = grant, false = explicit deny
  branchId     String? // Optional branch-level permission scoping
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique // Refresh token
  deviceInfo   String?
  browser      String?
  ipAddress    String?
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String // Login, Logout, Password Changed, etc.
  entityType String?
  entityId   String?
  details    String? // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ==========================================
// CORE DOMAIN MODELS (StudioOS ERP)
// ==========================================

enum CatalogItemType {
  PHYSICAL_PRODUCT
  SERVICE
}

enum OrderStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum ProductionJobStatus {
  PENDING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Category {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  description      String?
  parentCategoryId String?
  displayOrder     Int       @default(0)
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parent   Category?     @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children Category[]    @relation("CategoryHierarchy")
  items    CatalogItem[]
  products Product[]

  @@index([parentCategoryId])
  @@index([displayOrder])
  @@index([isActive])
}

model Supplier {
  id             String   @id @default(uuid())
  supplierNumber String   @unique
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  catalogItems   CatalogItem[]
  inventoryItems InventoryItem[]
}

model Customer {
  id             String   @id @default(uuid())
  customerNumber String   @unique
  name           String
  companyName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]
}

model Brand {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String    @unique
  description String?
  logoUrl     String?
  website     String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([code])
  @@index([name])
  @@index([isActive])
}

model UnitOfMeasure {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String    @unique
  abbreviation  String    @unique
  description   String?
  decimalPlaces Int       @default(2)
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  catalogItems CatalogItem[]
  products     Product[]

  @@index([code])
  @@index([name])
  @@index([abbreviation])
  @@index([isActive])
}

model CatalogItem {
  id                 String          @id @default(uuid())
  sku                String          @unique
  name               String
  description        String?
  itemType           CatalogItemType
  price              Decimal         @db.Decimal(10, 2)
  costPrice          Decimal?        @db.Decimal(10, 2)
  barcode            String?         @unique
  isActive           Boolean         @default(true)
  categoryId         String?
  workflowTemplateId String?
  supplierId         String?
  uomId              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  workflowTemplate WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  uom              UnitOfMeasure?    @relation(fields: [uomId], references: [id], onDelete: SetNull)
  inventoryItem    InventoryItem?
  orderItems       OrderItem[]
}

model InventoryItem {
  id              String   @id @default(uuid())
  catalogItemId   String   @unique
  sku             String
  quantityOnHand  Int      @default(0)
  reorderLevel    Int      @default(0)
  reorderQuantity Int      @default(0)
  location        String?
  supplierId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogItem    CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
}

model StockMovement {
  id              String            @id @default(uuid())
  inventoryItemId String
  type            StockMovementType
  quantity        Int
  reason          String?
  referenceNumber String?
  createdById     String?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  catalogItems   CatalogItem[]
  workflowSteps  WorkflowStep[]
  productionJobs ProductionJob[]
}

model WorkflowStep {
  id                 String   @id @default(uuid())
  workflowTemplateId String
  stepOrder          Int
  name               String
  description        String?
  estimatedMinutes   Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  customerId     String?
  status         OrderStatus @default(DRAFT)
  totalAmount    Decimal     @db.Decimal(10, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal     @default(0) @db.Decimal(10, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  payments       Payment[]
  productionJobs ProductionJob[]
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  catalogItemId String?
  itemType      CatalogItemType
  name          String
  quantity      Int
  unitPrice     Decimal         @db.Decimal(10, 2)
  totalPrice    Decimal         @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem?   @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  productionJob ProductionJob?
}

model Payment {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  orderId       String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String
  reference     String?
  status        PaymentStatus @default(COMPLETED)
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model ProductionJob {
  id                 String              @id @default(uuid())
  jobNumber          String              @unique
  orderId            String?
  orderItemId        String?             @unique
  workflowTemplateId String?
  currentStep        String?
  status             ProductionJobStatus @default(PENDING)
  assignedToId       String?
  notes              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  order            Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem        OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  workflowTemplate WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  assignedTo       User?             @relation("ProductionJobAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
}

model Product {
  id          String  @id @default(uuid())
  sku         String  @unique
  barcode     String? @unique
  name        String
  description String?

  categoryId String
  brandId    String
  unitId     String

  costPrice    Decimal @db.Decimal(18, 4)
  sellingPrice Decimal @db.Decimal(18, 4)

  minimumStock Int
  maximumStock Int
  reorderPoint Int

  trackInventory         Boolean @default(true)
  allowNegativeInventory Boolean @default(false)
  isActive               Boolean @default(true)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit     UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([sku])
  @@index([barcode])
  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([isActive])
}
