# StudioOS Environment Configuration

# Core Application Configuration
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studio_os?schema=public"

# Security & Authentication
JWT_SECRET="super-secret-key-change-in-production"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Storage Services (Optional / Future Use)
STORAGE_PROVIDER=
STORAGE_BUCKET=

# Email Services (Optional / Future Use)
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# OAuth Services (Optional / Future Use)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
